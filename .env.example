# Core service
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# Data mode switch (supports HISTORICAL_DATA or Historical_Data)
HISTORICAL_DATA=true

# Optional explicit paths (can be absolute or repo-relative)
SP500_DATA_DIR=BTP/sp500
MODEL_DATA_DIR=BTP/models_p3_metaquant
TICKER_MAPPING_FILE=BTP/extra_data/ticker_to_company_mapping.csv

# Frontend origin(s)
ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional tuning
MAX_UNIVERSE_SIZE=150
DEFAULT_USER_INITIALS=QR
BASE_NOTIONAL_USD=420000000
